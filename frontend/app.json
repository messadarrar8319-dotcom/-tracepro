{
  "expo": {
    "name": "TRACEPRO",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tracepro",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.foodtraceability.ie8fn5",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanner codes-barres et QR codes des produits",
        "NSPhotoLibraryUsageDescription": "Ajouter photos d'étiquettes et bons de livraison"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E65100"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.foodtraceability.ie8fn5",
      "permissions": ["android.permission.CAMERA", "android.permission.READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#18181B"
        }
      ],
      ["expo-camera", { "cameraPermission": "Scanner codes-barres et QR codes." }],
      ["expo-image-picker", { "photosPermission": "Ajouter des photos aux réceptions." }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
